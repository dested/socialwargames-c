// Prisma schema — https://pris.ly/d/prisma-schema
//
// Models match better-auth's required shape (user / session / account /
// verification). Field names are camelCase (better-auth queries them by name);
// columns are snake_case via `@map` to match the prior Drizzle layout, so an
// existing dev database keeps working unchanged.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")

  // set by better-auth's anonymous plugin (guest drop-in auth)
  isAnonymous Boolean? @default(false) @map("is_anonymous")

  sessions    Session[]
  accounts    Account[]
  posts       Post[]
  gamePlayers GamePlayer[]
  votes       Vote[]
  rallies     Rally[]
  stats       PlayerStat[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @map("updated_at")

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @default(now()) @map("updated_at")

  @@map("verification")
}

// ---- Social War Games ----

model Game {
  id            String   @id @default(uuid())
  mode          String // 'blitz' | 'campaign'
  seed          Int
  mapRadius     Int      @map("map_radius")
  roundNumber   Int      @default(0) @map("round_number")
  roundSeconds  Int      @map("round_seconds")
  roundEndsAt   DateTime @map("round_ends_at")
  status        String   @default("active") // 'active' | 'finished'
  winnerFaction Int?     @map("winner_faction")
  createdAt     DateTime @default(now()) @map("created_at")

  players GamePlayer[]
  rounds  Round[]
  votes   Vote[]
  rallies Rally[]
  stats   PlayerStat[]

  @@index([status])
  @@map("game")
}

model GamePlayer {
  id     String @id @default(uuid())
  gameId String @map("game_id")
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  faction Int
  // energy is reconciled lazily: effective = min(cap, voteEnergy + regen * (game.round - energyRound))
  voteEnergy  Int      @default(5) @map("vote_energy")
  energyRound Int      @default(0) @map("energy_round")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([gameId, userId])
  @@map("game_player")
}

model Round {
  id        String   @id @default(uuid())
  gameId    String   @map("game_id")
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  number    Int
  snapshot  Json
  events    Json
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([gameId, number])
  @@map("round")
}

model Vote {
  id       String  @id @default(uuid())
  gameId   String  @map("game_id")
  game     Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  round    Int
  playerId String  @map("player_id")
  player   User    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  unitId   Int     @map("unit_id")
  action   Json
  weight   Int     @default(1)
  rallyId  String? @map("rally_id")
  rally    Rally?  @relation(fields: [rallyId], references: [id], onDelete: SetNull)

  @@unique([gameId, round, playerId, unitId])
  @@index([gameId, round])
  @@map("vote")
}

model Rally {
  id        String   @id @default(uuid())
  shortCode String   @unique @map("short_code")
  gameId    String   @map("game_id")
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  creatorId String   @map("creator_id")
  creator   User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  slate     Json // { unitId, action }[]
  applies   Int      @default(0)
  round     Int // round it was composed for (display only; slates stay valid while units live)
  createdAt DateTime @default(now()) @map("created_at")

  votes Vote[]

  @@map("rally")
}

model PlayerStat {
  id       String @id @default(uuid())
  playerId String @map("player_id")
  player   User   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  gameId   String @map("game_id")
  game     Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  stat     String
  total    Int    @default(0)

  @@unique([playerId, gameId, stat])
  @@index([gameId, stat])
  @@map("player_stat")
}

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String
  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("post")
}
